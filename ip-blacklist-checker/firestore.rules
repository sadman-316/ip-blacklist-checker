rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Monitored IPs rules
    match /monitored_ips/{ipId} {
      allow read, write: if true;
    }

    // Scans rules
    match /scans/{scanId} {
      allow read, write: if true;
    }

    // Notifications rules
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // System settings rules
    match /system_settings/{settingsId} {
      allow read, write: if true;
    }

    // Daily reports rules
    match /daily_reports/{reportId} {
      allow read, write: if true;
    }
  }
}
